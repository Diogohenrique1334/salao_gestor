# ---------------------------------------------------------------------------
# secrets.toml.example — MODELO. Copie para `.streamlit/secrets.toml` (gitignored)
# e preencha. O app le via st.secrets / settings.py.
# ---------------------------------------------------------------------------

# Banco Neon (Postgres). Pegue a connection string no painel do Neon.
# Use o driver psycopg2 e sslmode=require.
database_url = "postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Chave para assinar o cookie de sessao (gere uma string aleatoria longa).
session_secret = "troque-por-uma-chave-aleatoria-bem-longa"

[salao]
# PRIMEIRO valor a configurar ao entregar para um salao novo: aparece no titulo
# do app e em TODA mensagem enviada ao cliente (confirmacao, lembrete, etc.).
nome = "Nome do Salao"
# Fuso do salao. O processo precisa rodar neste fuso (Dockerfile/workflow fixam
# TZ); as datas de agendamento sao hora local naive.
timezone = "America/Sao_Paulo"

[gestor]
# Conta admin inicial criada pelo seed (Etapa 1).
email = "gestor@salao.com"
senha = "troque-esta-senha"

[smtp]
# Gmail com app password (2FA ligado).
host = "smtp.gmail.com"
port = 587
user = "seu-email@gmail.com"
password = "app-password-de-16-digitos"
remetente = "Nome do Salao <seu-email@gmail.com>"

[whatsapp]
# Meta WhatsApp Cloud API.
token = "EAAG..."
phone_number_id = "1234567890"
template_confirmacao = "confirmacao_agendamento"
template_lembrete = "lembrete_agendamento"
idioma_template = "pt_BR"
